LOCAL_DATABASE_URL ?= postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
LOCAL_AMQP_URL     ?= amqp://ledger:ledger@localhost:5672/

# Local API keys written by `make dev-env` (gitignored).
-include .env

.DEFAULT_GOAL := help

.PHONY: help build run test test-integration cover lint fmt tidy up down deps-up deps-down logs docker-build dev-env check-env

help: ## Show available targets
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z_-]+:.*## / {printf "  \033[36m%-17s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

build: ## Build the binary into ./bin
	CGO_ENABLED=0 go build -trimpath -o bin/ledger ./cmd/ledger

run: check-env deps-up ## Run the service locally against the compose dependencies
	DATABASE_URL='$(LOCAL_DATABASE_URL)' AMQP_URL='$(LOCAL_AMQP_URL)' AMQP_QUEUE=ledger.events.audit LOG_FORMAT=text \
		AUTH_API_KEYS='$(AUTH_API_KEYS)' go run ./cmd/ledger

dev-env: ## Create a gitignored .env with random API keys for local development
	@test ! -e .env || { echo ".env already exists; delete it to generate new keys"; exit 1; }
	@set -e; umask 077; \
	set -- $$(go run ./cmd/apikey -client dev-operator -role operator); op_key=$$1; op_entry=$$2; \
	set -- $$(go run ./cmd/apikey -client dev-client -role client); cl_key=$$1; cl_entry=$$2; \
	test -n "$$op_entry" && test -n "$$cl_entry"; \
	{ echo '# Local development only, generated by `make dev-env`. Never commit this file.'; \
	  echo "DEV_OPERATOR_API_KEY=$$op_key"; \
	  echo "DEV_CLIENT_API_KEY=$$cl_key"; \
	  echo "AUTH_API_KEYS=$$op_entry,$$cl_entry"; } > .env
	@echo "Wrote .env with an operator key (DEV_OPERATOR_API_KEY) and a client key (DEV_CLIENT_API_KEY)."

check-env:
	@test -e .env || { echo "missing .env with local API keys: run 'make dev-env' first"; exit 1; }

test: ## Run unit tests
	go test -race -count=1 ./...

test-integration: deps-up ## Run unit and integration tests against PostgreSQL and RabbitMQ
	TEST_DATABASE_URL='$(LOCAL_DATABASE_URL)' TEST_AMQP_URL='$(LOCAL_AMQP_URL)' \
		go test -race -count=1 -tags=integration ./...

cover: deps-up ## Run all tests and print total coverage
	TEST_DATABASE_URL='$(LOCAL_DATABASE_URL)' TEST_AMQP_URL='$(LOCAL_AMQP_URL)' \
		go test -count=1 -tags=integration -coverpkg=./internal/... -coverprofile=coverage.out ./...
	go tool cover -func=coverage.out | tail -n 1

lint: ## Run golangci-lint
	golangci-lint run ./...

fmt: ## Format the code
	golangci-lint fmt ./...

tidy: ## Tidy go.mod and go.sum
	go mod tidy

up: check-env ## Build and start the full stack (app, PostgreSQL, RabbitMQ)
	docker compose up --build -d --wait

down: ## Stop the stack and delete its data
	docker compose down -v

deps-up: ## Start only PostgreSQL and RabbitMQ
	docker compose up -d --wait postgres rabbitmq

deps-down: ## Stop PostgreSQL and RabbitMQ
	docker compose stop postgres rabbitmq

logs: ## Follow the application logs
	docker compose logs -f app

docker-build: ## Build the container image
	docker build -t go-ledger-service:local .
